# ============================================================
# 部署环境配置模板
# 用法:cp deploy/.env.example deploy/.env,然后填写带 <填写> 的项
# (deploy.sh 会自动从本文件生成 .env 并填入随机 DB 密码)
# 注意:deploy/.env 已被 .gitignore 忽略,不会提交到 git
# ============================================================

# ---------- 域名 / SSL ----------
DOMAIN=wanzhixuexi.cn
# Let's Encrypt 证书到期通知邮箱(必填)
ACME_EMAIL=<填写你的邮箱>

# ---------- PostgreSQL ----------
POSTGRES_USER=satwatch
# deploy.sh 会自动生成强随机密码覆盖此值;若手动改,请勿含特殊字符(避免 URL 编码问题)
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=satwatch

# ---------- 豆包 LLM(火山方舟) ----------
# 从本地 .env.local 复制 LLM_API_KEY 的值;留空则 AI 任务规划返回 MISSING_CONFIG(其余功能不受影响)
LLM_API_KEY=<填写>
LLM_API_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=ep-20260408153341-2ztdd
LLM_TIMEOUT_MS=60000
